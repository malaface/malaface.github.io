---
import { siteConfig } from '../config/site';
import ThemeToggle from './ThemeToggle.astro';

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? currentPath === href : currentPath === href || currentPath.startsWith(href);
---

<header class="command-header">
  <div class="command-header__inner">
    <a class="brand" href="/" aria-label={`${siteConfig.shortName}, ir al inicio`}>
      <span class="brand__mark" aria-hidden="true"></span>
      <span>{siteConfig.shortName}</span>
    </a>

    <nav class="command-nav" aria-label="Navegación principal">
      <ul>
        {siteConfig.navigation.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="command-header__actions">
      <a class="search-link" href="/search/" aria-label="Buscar en el sitio">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
          <circle cx="11" cy="11" r="6.5"></circle>
          <path d="m16 16 4 4"></path>
        </svg>
        <span>Buscar</span>
      </a>
      <ThemeToggle />
    </div>
  </div>
</header>
