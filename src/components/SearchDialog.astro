<dialog
  class="search-dialog"
  data-search-dialog
  data-pagefind-module="/pagefind/pagefind.js"
  aria-labelledby="search-dialog-title"
>
  <div class="search-dialog__panel">
    <header>
      <div>
        <p class="eyebrow">Índice local</p>
        <h2 id="search-dialog-title">Buscar en el sitio</h2>
      </div>
      <button class="search-dialog__close" type="button" data-search-close aria-label="Cerrar búsqueda">×</button>
    </header>

    <form class="search-dialog__form" role="search" aria-label="Buscar en el sitio" data-search-form>
      <label for="site-search-query">Término de búsqueda</label>
      <div>
        <input
          id="site-search-query"
          name="q"
          type="search"
          minlength="2"
          autocomplete="off"
          placeholder="Ejemplo: automatización"
          required
          data-search-input
        />
        <button class="button-link" type="submit">Buscar</button>
      </div>
    </form>

    <p class="search-dialog__status" aria-live="polite" data-search-status>
      Escribe al menos dos caracteres para consultar el índice de este sitio.
    </p>
    <ol class="search-dialog__results" data-search-results></ol>
  </div>
</dialog>

<script>
  interface PagefindData {
    url: string;
    meta?: { title?: string };
    plain_excerpt?: string;
  }

  interface PagefindResult {
    data: () => Promise<PagefindData>;
  }

  interface PagefindModule {
    init: () => Promise<void>;
    search: (query: string) => Promise<{ results: PagefindResult[] }>;
  }

  const dialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]');
  const form = dialog?.querySelector<HTMLFormElement>('[data-search-form]');
  const input = dialog?.querySelector<HTMLInputElement>('[data-search-input]');
  const status = dialog?.querySelector<HTMLElement>('[data-search-status]');
  const results = dialog?.querySelector<HTMLOListElement>('[data-search-results]');
  let pagefindPromise: Promise<PagefindModule> | undefined;

  const loadPagefind = () => {
    if (!dialog) return Promise.reject(new Error('No se encontró el diálogo de búsqueda.'));

    pagefindPromise ??= import(/* @vite-ignore */ dialog.dataset.pagefindModule ?? '/pagefind/pagefind.js')
      .then(async (pagefind: PagefindModule) => {
        await pagefind.init();
        return pagefind;
      });

    return pagefindPromise;
  };

  const localResultUrl = (value: string) => {
    const url = new URL(value, window.location.origin);
    if (url.origin !== window.location.origin) throw new Error('La búsqueda devolvió una URL externa.');
    return `${url.pathname}${url.search}${url.hash}`;
  };

  const renderResult = (data: PagefindData) => {
    const item = document.createElement('li');
    const link = document.createElement('a');
    const excerpt = document.createElement('p');

    link.href = localResultUrl(data.url);
    link.append(document.createTextNode(data.meta?.title?.trim() || 'Resultado sin título'));
    excerpt.append(document.createTextNode(data.plain_excerpt?.trim() || 'Sin resumen disponible.'));
    item.append(link, excerpt);

    return item;
  };

  const openSearch = async (event: Event) => {
    event.preventDefault();
    if (!dialog || !input || !status) return;

    if (!dialog.open) dialog.showModal();
    input.focus();
    status.textContent = 'Preparando el índice local…';

    try {
      await loadPagefind();
      status.textContent = 'Índice listo. Escribe al menos dos caracteres para buscar.';
    } catch {
      status.textContent = 'No fue posible cargar el índice local. Intenta de nuevo más tarde.';
    }
  };

  document.querySelectorAll<HTMLElement>('[data-search-open]').forEach((opener) => {
    opener.addEventListener('click', openSearch);
  });

  dialog?.querySelector<HTMLElement>('[data-search-close]')?.addEventListener('click', () => dialog.close());

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const query = input?.value.trim() ?? '';
    if (!input || !status || !results || query.length < 2) {
      input?.focus();
      if (status) status.textContent = 'Escribe al menos dos caracteres para buscar.';
      return;
    }

    status.textContent = 'Buscando…';
    results.replaceChildren();

    try {
      const pagefind = await loadPagefind();
      const response = await pagefind.search(query);
      const entries = await Promise.all(response.results.slice(0, 10).map((result) => result.data()));
      const renderedEntries = entries.flatMap((entry) => {
        try {
          return [renderResult(entry)];
        } catch {
          return [];
        }
      });

      results.append(...renderedEntries);
      status.textContent = renderedEntries.length === 1
        ? '1 resultado encontrado.'
        : `${renderedEntries.length} resultados encontrados.`;
    } catch {
      status.textContent = 'No fue posible completar la búsqueda local. Intenta de nuevo.';
    }
  });
</script>

<style>
  .search-dialog {
    width: min(calc(100% - 2rem), 48rem);
    max-height: min(48rem, calc(100vh - 2rem));
    padding: 0;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius);
    background: var(--color-background-raised);
    color: var(--color-text);
    box-shadow: var(--shadow-card);
  }

  .search-dialog::backdrop {
    background: rgb(0 0 0 / 0.72);
    backdrop-filter: blur(0.35rem);
  }

  .search-dialog__panel {
    padding: clamp(1.25rem, 4vw, 2rem);
  }

  .search-dialog header,
  .search-dialog__form > div {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .search-dialog header {
    justify-content: space-between;
    margin-bottom: var(--space-5);
  }

  .search-dialog h2,
  .search-dialog header p {
    margin-bottom: 0;
  }

  .search-dialog__close {
    width: 2.5rem;
    min-height: 2.5rem;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-small);
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
    font-size: 1.5rem;
  }

  .search-dialog__form label {
    display: block;
    margin-bottom: var(--space-2);
    font-weight: 700;
  }

  .search-dialog__form input {
    min-width: 0;
    flex: 1;
    min-height: 2.75rem;
    padding-inline: 0.8rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-small);
    background: var(--color-background);
    color: var(--color-text);
  }

  .search-dialog__form .button-link {
    border: 0;
    cursor: pointer;
  }

  .search-dialog__status {
    margin-block: var(--space-4);
    color: var(--color-muted);
  }

  .search-dialog__results {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .search-dialog__results li {
    padding-block: var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  .search-dialog__results a {
    font-weight: 720;
  }

  .search-dialog__results p {
    margin-block: var(--space-1) 0;
    color: var(--color-muted);
  }

  @media (max-width: 34rem) {
    .search-dialog__form > div {
      align-items: stretch;
      flex-direction: column;
    }
  }
</style>
