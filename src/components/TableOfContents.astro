---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const visibleHeadings = headings.filter(({ depth }) => depth === 2 || depth === 3);
---

{visibleHeadings.length > 0 && (
  <nav class="table-of-contents" aria-labelledby="toc-title">
    <p class="eyebrow" id="toc-title">En esta página</p>
    <ol>
      {visibleHeadings.map((heading) => (
        <li class:list={{ 'table-of-contents__nested': heading.depth === 3 }}>
          <a href={`#${heading.slug}`}>{heading.text}</a>
        </li>
      ))}
    </ol>
  </nav>
)}
