---
import { getCollection } from 'astro:content';
import ContentCard from '../../components/ContentCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categoryLabels, contentHref, getPublishedEntries } from '../../lib/content';

const entries = getPublishedEntries(await getCollection('playbooks'));
const categories = [...new Set(entries.map((entry) => entry.data.category))];
---

<BaseLayout
  title="Guías"
  description="Procesos públicos y repetibles para comunicar mejor, dar seguimiento y reducir trabajo manual."
>
  <header class="page-intro">
    <p class="eyebrow">Guías prácticas</p>
    <h1>Pasos claros para avanzar con menos repetición</h1>
    <p>
      Flujos pensados para quienes cuidan su trabajo y ayudan a otras personas: profesionales de la salud, negocios
      familiares y PYMEs de servicios.
    </p>
  </header>

  {categories.map((category) => (
    <section class="content-section" aria-labelledby={`category-${category}`}>
      <div class="section-heading">
        <p class="eyebrow">Tema publicado</p>
        <h2 id={`category-${category}`}>{categoryLabels[category]}</h2>
      </div>
      <div class="content-grid">
        {entries
          .filter((entry) => entry.data.category === category)
          .map((entry) => <ContentCard entry={entry} href={contentHref(entry)} />)}
      </div>
    </section>
  ))}
</BaseLayout>
