---
import { getCollection } from 'astro:content';
import ContentCard from '../../components/ContentCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categoryLabels, contentHref, getPublishedEntries } from '../../lib/content';

const entries = getPublishedEntries(await getCollection('lab'));
const categories = [...new Set(entries.map((entry) => entry.data.category))];
---

<BaseLayout
  title="Laboratorio"
  description="Experimentos públicos y verificables orientados a experiencias claras y resultados de negocio útiles."
>
  <header class="page-intro">
    <p class="eyebrow">Laboratorio público</p>
    <h1>Probar pequeño para aprender con evidencia</h1>
    <p>
      Experimentos que parten de resultados observables —mejor alcance, seguimiento más claro o menos tareas
      repetitivas— y presentan la tecnología únicamente como medio.
    </p>
  </header>

  {categories.map((category) => (
    <section class="content-section" aria-labelledby={`category-${category}`}>
      <div class="section-heading">
        <p class="eyebrow">Tema publicado</p>
        <h2 id={`category-${category}`}>{categoryLabels[category]}</h2>
      </div>
      <div class="content-grid">
        {entries
          .filter((entry) => entry.data.category === category)
          .map((entry) => <ContentCard entry={entry} href={contentHref(entry)} />)}
      </div>
    </section>
  ))}
</BaseLayout>
