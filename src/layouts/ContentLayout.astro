---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import RelatedContent from '../components/RelatedContent.astro';
import TableOfContents from '../components/TableOfContents.astro';
import TagList from '../components/TagList.astro';
import { collectionDetails, readingTime, type PublicEntry } from '../lib/content';

interface Props {
  entry: PublicEntry;
  headings: MarkdownHeading[];
  related: PublicEntry[];
}

const { entry, headings, related } = Astro.props;
const collection = collectionDetails[entry.collection];
const minutes = readingTime(entry.body ?? '');
const dateFormatter = new Intl.DateTimeFormat('es-MX', {
  day: '2-digit',
  month: 'long',
  year: 'numeric'
});
---

<BaseLayout title={entry.data.title} description={entry.data.description} article>
  <article class="article-shell">
    <nav class="breadcrumbs" aria-label="Migas de pan">
      <ol>
        <li><a href="/">Inicio</a></li>
        <li><a href={collection.href}>{collection.label}</a></li>
        <li aria-current="page">{entry.data.title}</li>
      </ol>
    </nav>

    <header class="article-header">
      <p class="eyebrow">{collection.label}</p>
      <h1>{entry.data.title}</h1>
      <p class="article-header__summary">{entry.data.description}</p>
      <div class="article-meta">
        <time datetime={entry.data.publishedAt.toISOString()}>
          Publicado el {dateFormatter.format(entry.data.publishedAt)}
        </time>
        {entry.data.updatedAt && (
          <time datetime={entry.data.updatedAt.toISOString()}>
            Actualizado el {dateFormatter.format(entry.data.updatedAt)}
          </time>
        )}
        <span>{minutes} min de lectura</span>
      </div>
      <TagList tags={entry.data.tags} />
    </header>

    <div class="article-layout">
      <aside><TableOfContents headings={headings} /></aside>
      <div class="prose"><slot /></div>
    </div>
  </article>

  <RelatedContent entries={related} />
</BaseLayout>
